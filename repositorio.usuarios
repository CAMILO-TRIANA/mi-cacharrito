	package com.micacharrito.repositorio;
	
	import java.util.Optional;
	import org.springframework.data.jpa.repository.JpaRepository;
	import org.springframework.data.jpa.repository.Query;
	import org.springframework.data.repository.query.Param;
	import org.springframework.stereotype.Repository;
	
	import com.micacharrito.modelo.Usuarios;
	
	@Repository
	public interface UsuariosRepositorio extends JpaRepository<Usuarios, Integer> {
	
	    public Optional<Usuarios> findByNumeroIdentificacionAndPassword(String numeroIdentificacion, String password);
	
	    public boolean existsByNumeroIdentificacion(String numeroIdentificacion);
	
	    public boolean existsByCorreo(String correo);
	
	    @Query(value = "SELECT * FROM usuarios WHERE numero_identificacion = :identificacion", nativeQuery = true)
	    public Optional<Usuarios> buscarPorNumeroIdentificacion(@Param("identificacion") String identificacion);
	}
