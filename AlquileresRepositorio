package com.micacharrito.repositorio;

import java.util.List;
import java.util.Optional;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;
import org.springframework.stereotype.Repository;

import com.micacharrito.modelo.Alquileres;

@Repository
public interface AlquileresRepositorio extends JpaRepository<Alquileres, Integer> {

    public List<Alquileres> findByEstado(String estado);

    public Optional<Alquileres> findByNumeroAlquiler(String numeroAlquiler);

    public List<Alquileres> findByUsuarioId(Integer usuarioId);

    @Query(value = "SELECT a.* FROM alquileres a JOIN vehiculos v ON a.vehiculo_id = v.id WHERE v.placa = :placa AND a.estado = 'Pendiente de entrega' LIMIT 1", nativeQuery = true)
    public Optional<Alquileres> buscarPendientePorPlaca(@Param("placa") String placa);
}
