package com.cacharrito.controlador;

import java.math.BigDecimal;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.time.temporal.ChronoUnit;
import java.util.List;
import java.util.Optional;
import java.util.UUID;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import com.cacharrito.modelo.Administradores;
import com.cacharrito.modelo.Alquileres;
import com.cacharrito.modelo.Auditoria;
import com.cacharrito.modelo.Usuarios;
import com.cacharrito.modelo.Vehiculos;
import com.cacharrito.repositorio.AdministradoresRepositorio;
import com.cacharrito.repositorio.AlquileresRepositorio;
import com.cacharrito.repositorio.AuditoriaRepositorio;
import com.cacharrito.repositorio.UsuariosRepositorio;
import com.cacharrito.repositorio.VehiculosRepositorio;

@RestController
@RequestMapping("/api/alquileres")
@CrossOrigin(origins = "*")
public class AlquileresControlador {

	@Autowired
	private AlquileresRepositorio alquileresRepositorio;

	@Autowired
	private UsuariosRepositorio usuariosRepositorio;

	@Autowired
	private VehiculosRepositorio vehiculosRepositorio;

	@Autowired
	private AdministradoresRepositorio administradoresRepositorio;

	@Autowired
	private AuditoriaRepositorio auditoriaRepositorio;

	@GetMapping
	public List<Alquileres> listarTodos() {
		return alquileresRepositorio.findAll();
	}

	@PostMapping("/solicitar")
	public ResponseEntity<?> solicitarAlquiler(@RequestParam Integer usuarioId, @RequestParam Integer vehiculoId,
			@RequestParam String fechaInicio, @RequestParam String fechaEntregaPactada) {

		Optional<Usuarios> uOpt = usuariosRepositorio.findById(usuarioId);
		Optional<Vehiculos> vOpt = vehiculosRepositorio.findById(vehiculoId);

		if (uOpt.isEmpty() || vOpt.isEmpty()) {
			return ResponseEntity.badRequest().body("Usuario o Vehículo no encontrado.");
		}

		Vehiculos v = vOpt.get();
		if (!"Disponible".equalsIgnoreCase(v.getEstado())) {
			return ResponseEntity.badRequest().body("El vehículo seleccionado no se encuentra disponible.");
		}

		LocalDate inicio = LocalDate.parse(fechaInicio);
		LocalDate pactada = LocalDate.parse(fechaEntregaPactada);
		long dias = ChronoUnit.DAYS.between(inicio, pactada);
		if (dias <= 0) dias = 1;

		BigDecimal valorTotal = v.getValorDia().multiply(BigDecimal.valueOf(dias));

		Alquileres alquiler = new Alquileres();
		alquiler.setNumeroAlquiler("ALQ-" + UUID.randomUUID().toString().substring(0, 8).toUpperCase());
		alquiler.setUsuario(uOpt.get());
		alquiler.setVehiculo(v);
		alquiler.setFechaInicio(inicio);
		alquiler.setFechaEntregaPactada(pactada);
		alquiler.setValorTotal(valorTotal);
		alquiler.setEstado("Pendiente de entrega");

		v.setEstado("Alquilado");
		vehiculosRepositorio.save(v);

		Alquileres guardado = alquileresRepositorio.save(alquiler);
		return ResponseEntity.ok(guardado);
	}

	@PutMapping("/cancelar")
	public ResponseEntity<?> cancelarAlquiler(@RequestParam Integer id) {
		Optional<Alquileres> aOpt = alquileresRepositorio.findById(id);
		if (aOpt.isEmpty()) {
			return ResponseEntity.notFound().build();
		}

		Alquileres alquiler = aOpt.get();
		if ("Entregado".equalsIgnoreCase(alquiler.getEstado()) || "Disponible".equalsIgnoreCase(alquiler.getEstado())) {
			return ResponseEntity.badRequest().body("No se puede cancelar un alquiler que ya fue procesado o finalizado.");
		}

		alquiler.setEstado("Cancelado");
		Vehiculos v = alquiler.getVehiculo();
		v.setEstado("Disponible");
		vehiculosRepositorio.save(v);

		alquileresRepositorio.save(alquiler);
		return ResponseEntity.ok("Alquiler cancelado exitosamente.");
	}

	@GetMapping("/pendientes")
	public List<Alquileres> listarPendientesNoEntregados() {
		return alquileresRepositorio.obtenerNoEntregados();
	}

	@PutMapping("/admin/entregar-cliente")
	public ResponseEntity<?> entregarVehiculoACliente(@RequestParam String placa, @RequestParam Integer adminId) {
		Optional<Alquileres> aOpt = alquileresRepositorio.buscarPendientePorPlaca(placa);
		Optional<Administradores> adminOpt = administradoresRepositorio.findById(adminId);

		if (aOpt.isEmpty()) {
			return ResponseEntity.badRequest().body("No hay solicitudes pendientes para la placa especificada.");
		}
		if (adminOpt.isEmpty()) {
			return ResponseEntity.badRequest().body("Administrador no válido.");
		}

		Alquileres alquiler = aOpt.get();
		alquiler.setEstado("Entregado");
		alquileresRepositorio.save(alquiler);

		Auditoria aud = new Auditoria();
		aud.setAdministrador(adminOpt.get());
		aud.setAlquiler(alquiler);
		aud.setAccion("ENTREGA_VEHICULO_CLIENTE");
		aud.setFechaRegistro(LocalDateTime.now());
		aud.setObservaciones("El vehículo con placa " + placa + " fue entregado al usuario.");
		auditoriaRepositorio.save(aud);

		return ResponseEntity.ok("Estado actualizado a Entregado.");
	}

	@PutMapping("/admin/recepcionar-retorno")
	public ResponseEntity<?> recepcionarRetornoVehiculo(@RequestParam String numeroAlquiler, @RequestParam Integer adminId) {
		Optional<Alquileres> aOpt = alquileresRepositorio.findByNumeroAlquiler(numeroAlquiler);
		Optional<Administradores> adminOpt = administradoresRepositorio.findById(adminId);

		if (aOpt.isEmpty() || adminOpt.isEmpty()) {
			return ResponseEntity.badRequest().body("Alquiler o Administrador no encontrado.");
		}

		Alquileres alquiler = aOpt.get();
		LocalDate hoy = LocalDate.now();
		alquiler.setFechaEntregaReal(hoy);

		String obs = "Devolución en fecha acordada.";
		if (hoy.isAfter(alquiler.getFechaEntregaPactada())) {
			long diasMora = ChronoUnit.DAYS.between(alquiler.getFechaEntregaPactada(), hoy);
			BigDecimal cobroExtra = alquiler.getVehiculo().getValorDia().multiply(BigDecimal.valueOf(diasMora));
			alquiler.setValorTotal(alquiler.getValorTotal().add(cobroExtra));
			obs = "Devolución con " + diasMora + " días de retraso. Recargo de $" + cobroExtra;
		}

		alquiler.setEstado("Disponible");
		Vehiculos v = alquiler.getVehiculo();
		v.setEstado("Disponible");
		vehiculosRepositorio.save(v);
		alquileresRepositorio.save(alquiler);

		Auditoria aud = new Auditoria();
		aud.setAdministrador(adminOpt.get());
		aud.setAlquiler(alquiler);
		aud.setAccion("RECEPCION_RETORNO");
		aud.setFechaRegistro(LocalDateTime.now());
		aud.setObservaciones(obs);
		auditoriaRepositorio.save(aud);

		return ResponseEntity.ok(alquiler);
	}
}


