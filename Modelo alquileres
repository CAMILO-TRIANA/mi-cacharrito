package com.micacharrito.modelo;

import java.math.BigDecimal;
import java.time.LocalDate;
import jakarta.persistence.Column;
import jakarta.persistence.Entity;
import jakarta.persistence.GeneratedValue;
import jakarta.persistence.GenerationType;
import jakarta.persistence.Id;
import jakarta.persistence.JoinColumn;
import jakarta.persistence.ManyToOne;
import jakarta.persistence.Table;

@Entity
@Table(name = "alquileres")
public class Alquileres {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    @Column(name = "id")
    private Integer id;

    @Column(name = "numero_alquiler", length = 30, nullable = false, unique = true)
    private String numeroAlquiler;

    @ManyToOne
    @JoinColumn(name = "usuario_id", nullable = false)
    private Usuarios usuario;

    @ManyToOne
    @JoinColumn(name = "vehiculo_id", nullable = false)
    private Vehiculos vehiculo;

    @Column(name = "fecha_inicio", nullable = false)
    private LocalDate fechaInicio;

    @Column(name = "fecha_entrega_pactada", nullable = false)
    private LocalDate fechaEntregaPactada;

    @Column(name = "fecha_entrega_real")
    private LocalDate fechaEntregaReal;

    @Column(name = "valor_total", nullable = false, precision = 10, scale = 2)
    private BigDecimal valorTotal;

    @Column(name = "estado", length = 30, nullable = false)
    private String estado = "Pendiente de entrega";

    public Alquileres() {
    }

    public Alquileres(Integer id, String numeroAlquiler, Usuarios usuario, Vehiculos vehiculo,
                      LocalDate fechaInicio, LocalDate fechaEntregaPactada, LocalDate fechaEntregaReal,
                      BigDecimal valorTotal, String estado) {
        this.id = id;
        this.numeroAlquiler = numeroAlquiler;
        this.usuario = usuario;
        this.vehiculo = vehiculo;
        this.fechaInicio = fechaInicio;
        this.fechaEntregaPactada = fechaEntregaPactada;
        this.fechaEntregaReal = fechaEntregaReal;
        this.valorTotal = valorTotal;
        this.estado = estado;
    }

    public Integer getId() {
        return id;
    }

    public void setId(Integer id) {
        this.id = id;
    }

    public String getNumeroAlquiler() {
        return numeroAlquiler;
    }

    public void setNumeroAlquiler(String numeroAlquiler) {
        this.numeroAlquiler = numeroAlquiler;
    }

    public Usuarios getUsuario() {
        return usuario;
    }

    public void setUsuario(Usuarios usuario) {
        this.usuario = usuario;
    }

    public Vehiculos getVehiculo() {
        return vehiculo;
    }

    public void setVehiculo(Vehiculos vehiculo) {
        this.vehiculo = vehiculo;
    }

    public LocalDate getFechaInicio() {
        return fechaInicio;
    }

    public void setFechaInicio(LocalDate fechaInicio) {
        this.fechaInicio = fechaInicio;
    }

    public LocalDate getFechaEntregaPactada() {
        return fechaEntregaPactada;
    }

    public void setFechaEntregaPactada(LocalDate fechaEntregaPactada) {
        this.fechaEntregaPactada = fechaEntregaPactada;
    }

    public LocalDate getFechaEntregaReal() {
        return fechaEntregaReal;
    }

    public void setFechaEntregaReal(LocalDate fechaEntregaReal) {
        this.fechaEntregaReal = fechaEntregaReal;
    }

    public BigDecimal getValorTotal() {
        return valorTotal;
    }

    public void setValorTotal(BigDecimal valorTotal) {
        this.valorTotal = valorTotal;
    }

    public String getEstado() {
        return estado;
    }

    public void setEstado(String estado) {
        this.estado = estado;
    }
}
